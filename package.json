{
  "name": "xuyiheng-tools",
  "version": "1.0.0",
  "private": true,
  "description": "一珩成长笔记 · 纯静态工具站（零运行时依赖）。main-tool Web 承载平移。",
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "prerender": "node scripts/prerender.js",
    "inject": "node scripts/inject-scripts.js",
    "minify": "node scripts/minify.js",
    "fingerprint": "node scripts/fingerprint.js",
    "sitemap": "node scripts/build-sitemap.js",
    "llms": "node scripts/build-llms.js",
    "registry": "node scripts/generate-tool-registry.js",
    "test": "node --test tests/unit/*.test.js && npm run check",
    "check": "node scripts/check-encoding.js && node scripts/check-tool-registry.js && node scripts/check-build-artifacts.js && node scripts/check-tools-sync.js && node scripts/check-links.js && node scripts/check-wcag.js",
    "check:encoding": "node scripts/check-encoding.js",
    "check:wcag": "node scripts/check-wcag.js",
    "check:registry": "node scripts/check-tool-registry.js",
    "check:artifacts": "node scripts/check-build-artifacts.js",
    "deploy": "npm run build && npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@xuyiheng/static-build-kit": "file:../packages/static-build-kit"
  }
}
