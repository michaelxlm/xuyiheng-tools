{
  "name": "xuyiheng-tools",
  "version": "1.0.0",
  "private": true,
  "description": "一珩成长笔记 · 纯静态工具站（零运行时依赖）。main-tool Web 承载平移。",
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "prerender": "node scripts/prerender.js",
    "inject": "node scripts/inject-scripts.js",
    "minify": "node scripts/minify.js",
    "fingerprint": "node scripts/fingerprint.js",
    "sitemap": "node scripts/build-sitemap.js",
    "llms": "node scripts/build-llms.js",
    "check": "node scripts/check-links.js && node scripts/check-wcag.js",
